# ==============================================================================
# IP-SAKTI Sahayak — Example Unified Environment Configuration
# Copy this file to .env and fill in your actual credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND (Vite / React)
# ------------------------------------------------------------------------------
VITE_BACKEND_BASE_URL=http://localhost:8080

# ------------------------------------------------------------------------------
# 2. SUPABASE (Database, Auth, pgvector Storage)
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_DB_PASSWORD=your-db-password

# ------------------------------------------------------------------------------
# 3. BACKEND SERVICE (Spring Boot)
# ------------------------------------------------------------------------------
SERVER_PORT=8080
SPRING_DATASOURCE_URL=jdbc:postgresql://db.your-project.supabase.co:5432/postgres
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your-db-password
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false
SPRING_JPA_FORMAT_SQL=false
SPRING_WEB_CLIENT_LOG_LEVEL=INFO
SPRING_HTTP_CONVERTER_LOG_LEVEL=INFO

# Backend Security & JWT
BACKEND_SECURITY_MODE=dev
BACKEND_API_KEY=
BACKEND_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080
BACKEND_JWT_ISSUER=ip-sakti-sahayak
BACKEND_JWT_SECRET=
BACKEND_JWT_ACCESS_TOKEN_TTL=30m

# Backend RAG Bridge Connection
RAG_BASE_URL=http://localhost:8000
RAG_CONNECT_TIMEOUT=2s
RAG_READ_TIMEOUT=20s

# ------------------------------------------------------------------------------
# 4. RAG SERVICE: EMBEDDING & LLM (OpenRouter)
# ------------------------------------------------------------------------------
EMBEDDING_PROVIDER=openrouter
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIMENSION=1536

OPENROUTER_API_KEY=sk-or-v1-your-key
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free,openrouter/free
LLM_PROVIDER=openrouter
LLM_MODEL=google/gemma-4-26b-a4b-it:free,openrouter/free
LLM_API_KEY=sk-or-v1-your-key

# ------------------------------------------------------------------------------
# 5. RAG SERVICE: RUNTIME TUNING & VECTOR SEARCH
# ------------------------------------------------------------------------------
RAG_ENABLE_LLM=true
RAG_ENABLE_GENERAL_LLM=true
RAG_STORAGE_BACKEND=local
RAG_TOP_K=8
RAG_CANDIDATE_K=24
RAG_MIN_SCORE=0.10
RAG_ABSTENTION_THRESHOLD=0.12
RAG_SIMILARITY_THRESHOLD=0.10
RAG_MAX_CONTEXT_CHARS=18000

# ------------------------------------------------------------------------------
# 6. OBSERVABILITY: LANGSMITH TRACING
# ------------------------------------------------------------------------------
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your-langsmith-key
LANGSMITH_PROJECT=IP Sakthi A RAG

# ------------------------------------------------------------------------------
# 7. MULTILINGUAL TRANSLATION (Gemini API)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite,gemini-3.1-flash-lite,gemini-3.5-flash-lite,gemini-flash-lite-latest
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_ENABLED=true
GEMINI_CONNECT_TIMEOUT=2s
GEMINI_READ_TIMEOUT=10s
