# ==============================================================================
# IP-SAKTI Sahayak — Example Unified Environment Configuration
# Copy this file to .env and fill in your actual credentials.
# ==============================================================================

# --- Frontend (Vite / React) ---
VITE_BACKEND_BASE_URL=http://localhost:8080

# --- Supabase (Database, Auth, pgvector Storage) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_DB_PASSWORD=your-db-password

# --- Backend Service (Spring Boot) ---
SERVER_PORT=8080
SPRING_DATASOURCE_URL=jdbc:postgresql://db.your-project.supabase.co:5432/postgres
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your-db-password
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false

BACKEND_SECURITY_MODE=dev
BACKEND_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080
RAG_BASE_URL=http://localhost:8000
RAG_CONNECT_TIMEOUT=2s
RAG_READ_TIMEOUT=20s

# --- RAG: Embedding & LLM (OpenRouter) ---
EMBEDDING_PROVIDER=openrouter
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIMENSION=1536

OPENROUTER_API_KEY=sk-or-v1-your-key
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free,openrouter/free

# --- RAG: Runtime Tuning ---
RAG_ENABLE_LLM=true
RAG_ENABLE_GENERAL_LLM=true
RAG_STORAGE_BACKEND=auto
RAG_TOP_K=8
RAG_CANDIDATE_K=24
RAG_MIN_SCORE=0.10
RAG_ABSTENTION_THRESHOLD=0.12
RAG_SIMILARITY_THRESHOLD=0.10
RAG_MAX_CONTEXT_CHARS=18000

# --- Observability (LangSmith Tracing) ---
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your-langsmith-key
LANGSMITH_PROJECT=IP Sakthi A RAG

# --- Multilingual Translation (Gemini ONLY) ---
GEMINI_API_KEY=<your-key>
GEMINI_MODEL=gemini-2.0-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_ENABLED=true
GEMINI_CONNECT_TIMEOUT=2s
GEMINI_READ_TIMEOUT=10s
